# ---- Browser (Vite, public — baked into the SPA at build time) ----
# Google OAuth client ID (Web application). Also used by the backend when GOOGLE_CLIENT_ID is not set.
VITE_GOOGLE_CLIENT_ID=
# Google API key (used by Google Picker only).
VITE_GOOGLE_API_KEY=
# Google Cloud project number (Picker app ID).
VITE_GOOGLE_APP_ID=

# ---- Server only (Vercel functions in /api; NEVER prefix with VITE_, never commit a real value) ----
# REQUIRED. OAuth client secret of the same client. Also the key material for the encrypted session cookie
# (changing it signs everyone out). In Vercel: add as a Sensitive environment variable.
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Optional. The only Google account allowed to sign in. Default: raztz2@gmail.com
ALLOWED_EMAIL=
